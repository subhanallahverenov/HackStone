# ---- Team5 Bank environment (all optional) ----
# Copy this file to .env to customize. Everything works without it.

# Server port (the app + API are served here)
PORT=4000

# JWT signing secret (change for anything beyond local demo)
JWT_SECRET=team5-dev-secret-change-me-please-0123456789

# ---- AI assistant (Symbolic AI) ----
# Leave OPENAI_API_KEY EMPTY to use the built-in offline mock assistant (zero setup).
# To use real AI, paste an OpenAI-compatible key below.
OPENAI_API_KEY=

# OpenAI-compatible base URL.
#   OpenAI:  https://api.openai.com/v1
#   Groq (free, no card): https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name.
#   OpenAI:  gpt-4o-mini
#   Groq:    llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
