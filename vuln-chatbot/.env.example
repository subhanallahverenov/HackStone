# ---- Vulnerable chatbot target (server.py) ----
# TWO AI models are supported ("mutual AI models"):
#   * ollama  -> LOCAL  model (offline) : tinyllama
#   * groq    -> PUBLIC model (cloud)   : llama-3.1-8b-instant
# server.py reads real environment variables; the easy way is 2-run-vuln-chatbot.bat.

# Default backend: auto | ollama | groq
#   auto = use groq if GROQ_API_KEY is set, otherwise ollama
AI_PROVIDER=auto

# ---- LOCAL model (Ollama) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# ---- PUBLIC model (Groq) ----
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxx
OPENAI_MODEL=llama-3.1-8b-instant
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Shorter replies = faster scans
MAX_TOKENS=80

# Tip: you can also switch model per request without restarting:
#   POST /chat  {"message": "hi", "provider": "groq"}
#   POST /chat  {"message": "hi", "provider": "ollama"}
# And inspect what is available:  GET /providers
